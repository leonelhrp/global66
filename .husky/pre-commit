#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."
echo ""

# 1. Run lint-staged
echo "📝 Linting and formatting staged files..."
npx lint-staged

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Lint-staged failed! Please fix the linting errors above."
  exit 1
fi

echo "✅ Linting passed!"
echo ""

# 2. Run tests
echo "🧪 Running tests to ensure nothing breaks..."
npm test

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Tests failed! Please fix the failing tests before committing."
  echo ""
  echo "Tip: Run 'npm test' locally to see detailed test results"
  exit 1
fi

echo ""
echo "✅ All pre-commit checks passed!"
echo "✅ Linting: OK"
echo "✅ Tests: OK (164 tests)"
