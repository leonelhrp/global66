{
  "name": "global66-test",
  "version": "1.0.0",
  "description": "Global66 - Plataforma de cambio de divisas y pagos internacionales",
  "author": "Global66",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "lint:fix": "eslint --ext .js,.vue --ignore-path .gitignore . --fix",
    "format": "prettier --write \"**/*.{js,vue,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,vue,css,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky 2>/dev/null || true"
  },
  "dependencies": {
    "core-js": "3.25.3",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "google-auth-library": "9.6.3",
    "google-spreadsheet": "4.1.2",
    "nuxt": "2.18.1",
    "vue": "2.7.10",
    "vue-server-renderer": "2.7.10",
    "vue-template-compiler": "2.7.10"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@nuxt/types": "2.18.1",
    "@nuxt/typescript-build": "3.0.2",
    "@nuxtjs/eslint-config": "12.0.0",
    "@nuxtjs/tailwindcss": "4.2.1",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-vue2": "2.3.1",
    "@vitest/coverage-v8": "2.1.8",
    "@vitest/ui": "2.1.8",
    "@vue/test-utils": "1.3.6",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-nuxt": "4.0.0",
    "eslint-plugin-vue": "9.33.0",
    "happy-dom": "15.11.7",
    "husky": "9.1.7",
    "jsdom": "25.0.1",
    "lint-staged": "16.2.6",
    "postcss": "8.4.18",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "tailwindcss": "2.2.19",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
